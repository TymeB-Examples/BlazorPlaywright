@using BlockchainBlazorWithE2EDemo.Models
@inherits BlockBase

<div class="block-wrapper">
    <h3>Block</h3>
    <div class="panel @(IsValid ? "valid" : "invalid")">
        <div class="form-row">
            <label>Block:</label>
            <input readonly value="@Index" />
        </div>

        <div class="form-row">
            <label>Nonce:</label>
            <input @bind="NonceString" />
        </div>

        <div class="form-row">
            <label>Data:</label>
            <textarea @bind="LocalData"></textarea>
        </div>

        <div class="form-row">
            <label>Prev:</label>
            <input readonly value="@Hex(PreviousHash)" />
        </div>

        <div class="form-row">
            <label>Hash:</label>
            <input readonly value="@Hex(Block.Hash)" />
        </div>

        <div class="form-actions">
            <button @onclick="MineAsync">Mine</button>
        </div>
        <div class="small">
            Computed: @Hex(ComputedHash) — @(IsValid ? "OK" : "INVALID")
        </div>
    </div>
</div>

<style>
.block-wrapper { margin-bottom: 1.25rem; }
.panel { padding: 1rem; border-radius: 4px; background: #e8f5e9; }
.panel.invalid { background: #fdecea; }
.form-row { display:flex; gap:0.75rem; align-items: center; margin-bottom:0.75rem; }
.form-row label { width: 4rem; font-weight:600; }
.form-row input[type="text"], .form-row input, textarea { flex:1; padding:0.5rem; border-radius:4px; border:1px solid #ccc; }
textarea { height: 8rem; resize: vertical; }
.form-actions { margin-top:0.5rem; }
.small { margin-top:0.5rem; color:#555; font-size:0.9rem; }
</style>